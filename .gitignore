# exported trunks (MAE encoder etc) live on the modal volumes, not in git
runs/*/results/*.pth
# stray 0-byte files from shell redirects, named after whatever was in scope.
# The glob matches EVERY filename (any name whose last char is not a dot), so the
# real logs have to be named back in or a new run's results vanish silently.
runs/*/results/*[!.]
!runs/*/results/*.csv
!runs/*/results/*.json
!runs/*/results/*.txt
!runs/*/results/*.md

